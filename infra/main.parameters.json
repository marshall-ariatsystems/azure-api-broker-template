{
  "$schema": "https://schema.management.azure.com/schemas/2019-04-01/deploymentParameters.json#",
  "contentVersion": "1.0.0.0",
  "parameters": {
    "resourceGroupName": { "value": "${AZURE_RESOURCE_GROUP}" },
    "location": { "value": "${AZURE_LOCATION}" },
    "environmentName": { "value": "${AZURE_ENV_NAME}" },
    "tenantId": { "value": "${AZURE_TENANT_ID}" },
    "operatorObjectId": { "value": "${OPERATOR_OBJECT_ID}" },
    "tags": {
      "value": {
        "CostCenter": "${AZURE_TAG_COST_CENTER}",
        "Owner": "${AZURE_TAG_OWNER}",
        "Workload": "${AZURE_TAG_WORKLOAD}",
        "Environment": "${AZURE_TAG_ENVIRONMENT}"
      }
    }
  }
}
