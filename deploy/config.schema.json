{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Tessera deployment configuration",
  "type": "object",
  "additionalProperties": false,
  "required": ["resourceGroup", "location", "environment", "operatorAllowedCidrs", "network"],
  "properties": {
    "subscriptionId": { "type": "string", "minLength": 1 },
    "resourceGroup": { "type": "string", "pattern": "^[A-Za-z0-9_.()-]{1,90}$" },
    "location": { "type": "string", "pattern": "^[a-z0-9]+$" },
    "environment": { "type": "string", "pattern": "^[a-z0-9][a-z0-9-]{1,31}$" },
    "operatorAllowedCidrs": { "type": "array", "minItems": 1, "maxItems": 20, "items": { "type": "string", "minLength": 3, "maxLength": 64 } },
    "network": {
      "type": "object",
      "additionalProperties": false,
      "required": ["mode", "addressPrefixes", "integrationSubnetCidr", "privateEndpointSubnetCidr", "adminIntegrationSubnetCidr"],
      "properties": {
        "mode": { "const": "isolated" },
        "addressPrefixes": { "type": "array", "minItems": 1, "items": { "type": "string" } },
        "integrationSubnetCidr": { "type": "string" },
        "privateEndpointSubnetCidr": { "type": "string" },
        "adminIntegrationSubnetCidr": { "type": "string" }
      }
    },
    "tags": { "type": "object", "additionalProperties": { "type": "string" } }
  }
}
