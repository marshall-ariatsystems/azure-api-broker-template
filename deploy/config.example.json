{
  "$schema": "./config.schema.json",
  "subscriptionId": "<azure-subscription-id>",
  "resourceGroup": "<new-or-existing-resource-group-name>",
  "location": "<azure-region>",
  "environment": "production",
  "operatorAllowedCidrs": ["<operator-public-ip-or-cidr>"],
  "network": {
    "mode": "isolated",
