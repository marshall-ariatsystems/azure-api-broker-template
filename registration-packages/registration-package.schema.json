{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "required": ["format", "version", "signingKeyId", "payload", "signature"],
  "additionalProperties": false,
  "properties": {
    "format": { "const": "tessera-registration/v1" }, "version": { "const": 1 },
    "signingKeyId": { "type": "string", "minLength": 1 }, "signature": { "type": "string", "pattern": "^[A-Za-z0-9_-]+$" },
    "payload": { "type": "object", "additionalProperties": false, "required": ["issuer", "clientId", "redirectUri"], "properties": {
      "displayName": { "type": "string" }, "issuer": { "type": "string", "format": "uri" }, "discovery": { "type": "string", "format": "uri" }, "clientId": { "type": "string" }, "redirectUri": { "type": "string", "format": "uri" }, "audience": { "type": "string" }, "audienceParameter": { "enum": ["audience", "resource"] }, "claims": { "type": "object" }, "assurance": { "type": "object" }, "bootstrap": { "type": "object" }, "grantType": { "const": "authorization_code" }
    }}
  }
}
