{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://tessera.example/schemas/registration-package-v1.json",
  "title": "Tessera signed registration package v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["formatVersion", "package", "signature"],
  "properties": {
    "formatVersion": { "const": 1 },
    "package": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "displayName", "discovery", "redirectUris", "resource", "claims", "assurance", "bootstrap"],
      "properties": {
        "id": { "type": "string", "pattern": "^regpkg:[a-z0-9][a-z0-9-]{0,63}$", "maxLength": 71 },
        "displayName": { "type": "string", "minLength": 1, "maxLength": 128 },
        "discovery": {
          "type": "object", "additionalProperties": false, "required": ["issuer"],
          "properties": { "issuer": { "type": "string", "format": "uri", "pattern": "^https://", "maxLength": 2048 } }
        },
        "redirectUris": {
          "type": "array", "minItems": 1, "maxItems": 8, "uniqueItems": true,
          "items": { "type": "string", "format": "uri", "pattern": "^(https://|http://127\\.0\\.0\\.1(?::[0-9]+)?(?:/|$))", "maxLength": 2048 }
        },
        "resource": {
          "type": "object", "additionalProperties": false, "required": ["audience"],
          "properties": { "audience": { "type": "string", "minLength": 1, "maxLength": 256, "pattern": "^\\S+$" } }
        },
        "claims": {
          "type": "object", "additionalProperties": false, "required": ["roles", "groups"],
          "properties": {
            "roles": { "type": "string", "pattern": "^[a-zA-Z0-9_.:-]{1,64}$" },
            "groups": { "type": "string", "pattern": "^[a-zA-Z0-9_.:-]{1,64}$" }
          }
        },
        "assurance": {
          "oneOf": [
            { "type": "object", "maxProperties": 0 },
            { "type": "object", "additionalProperties": false, "required": ["claim", "equals"], "properties": {
              "claim": { "type": "string", "pattern": "^[a-zA-Z0-9_.:-]{1,64}$" },
              "equals": { "type": "string", "minLength": 1, "maxLength": 256 }
            } }
          ]
        },
        "bootstrap": { "type": "array", "maxItems": 16, "items": { "type": "string", "minLength": 1, "maxLength": 512 } }
      }
    },
    "signature": {
      "type": "object", "additionalProperties": false, "required": ["algorithm", "publicKeySpki", "value"],
      "properties": {
        "algorithm": { "const": "Ed25519" },
        "publicKeySpki": { "type": "string", "pattern": "^[A-Za-z0-9+/]+={0,2}$" },
        "value": { "type": "string", "pattern": "^[A-Za-z0-9+/]+={0,2}$" }
      }
    }
  }
}
