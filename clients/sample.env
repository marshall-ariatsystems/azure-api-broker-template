# clients/sample.env — developer environment.
# This file holds ONLY non-sensitive identifiers. NEVER put a vendor key here.
# spec hard_constraint: real vendor keys must never appear in .env files.

# Broker endpoint (resolved over the existing Meraki/VPN private path — spec §7.1)
BROKER_HOST=broker.contoso.com

# Entra identity (placeholders — substitute real values from the admin)
TENANT_ID=11111111-1111-1111-1111-111111111111              # PLACEHOLDER
APP_ID_URI=api://00000000-0000-0000-0000-000000000000        # PLACEHOLDER broker App ID URI
EXPECTED_AUD=00000000-0000-0000-0000-000000000000           # PLACEHOLDER broker client-id GUID
EXPECTED_ISS=https://login.microsoftonline.com/11111111-1111-1111-1111-111111111111/v2.0  # PLACEHOLDER

# There is intentionally NO vendor key, NO api-key, NO bearer token in this file.
# Acquire a short-lived token per session: az account get-access-token --scope "${APP_ID_URI}/.default"
