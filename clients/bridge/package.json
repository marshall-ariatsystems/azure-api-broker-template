{
  "name": "broker-bridge",
  "version": "1.0.0",
  "description": "Drop-in local proxy: existing apps use the key broker with a one-line base-URL change and no vendor credentials. Entra identity in, brokered vendor call out.",
  "type": "module",
  "main": "broker-bridge.mjs",
  "author": "gitmarsh <marsh@cloudmarsh.com>",
  "license": "Apache-2.0",
  "engines": { "node": ">=18" },
  "scripts": {
    "start": "node broker-bridge.mjs",
    "init": "node broker-bridge.mjs init",
    "serve": "node broker-bridge.mjs serve",
    "run": "node broker-bridge.mjs run",
    "test": "node --test test/*.test.mjs",
    "bundle": "esbuild broker-bridge.mjs --bundle --platform=node --format=cjs --outfile=dist/broker-bridge.cjs",
    "package": "node scripts/package-sea.mjs"
  },
  "dependencies": {
    "@azure/identity": "^4.5.0"
  },
  "devDependencies": {
    "esbuild": "^0.28.1"
  }
}
