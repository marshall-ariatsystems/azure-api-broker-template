{
  "$schema": "https://schema.management.azure.com/schemas/2019-04-01/deploymentTemplate.json#",
  "contentVersion": "1.0.0.0",
  "metadata": {
    "_generator": {
      "name": "bicep",
      "version": "0.42.1.51946",
      "templateHash": "13942712854739746287"
    }
  },
  "parameters": {
    "functionName": {
      "type": "string",
      "metadata": {
        "description": "Function app name (from iac/outputs.json)."
      }
    },
    "brokerClientId": {
      "type": "string",
      "defaultValue": "00000000-0000-0000-0000-000000000000",
      "metadata": {
        "description": "Broker app registration client-id GUID (from identity/outputs.json; substitute real value at deploy time). PLACEHOLDER."
      }
    },
    "brokerIssuer": {
      "type": "string",
      "defaultValue": "https://login.microsoftonline.com/11111111-1111-1111-1111-111111111111/v2.0",
      "metadata": {
        "description": "Broker v2 issuer (from identity/outputs.json). Must end with /v2.0."
      }
    },
    "brokerAppIdUri": {
      "type": "string",
      "defaultValue": "api://00000000-0000-0000-0000-000000000000",
      "metadata": {
        "description": "Broker App ID URI (from identity/outputs.json). Accepted alongside the GUID audience."
      }
    },
    "excludedAuthPaths": {
      "type": "array",
      "defaultValue": [],
      "metadata": {
        "description": "Unauthenticated paths that bypass Easy Auth (e.g., /api/health for availability probes). CAUTION: exposes an endpoint; disabled by default. Set to specific paths only if required."
      }
    },
    "authMode": {
      "type": "string",
      "defaultValue": "entra",
      "allowedValues": [
        "entra",
        "generic-oidc"
      ]
    },
    "genericOidcIssuer": {
      "type": "string",
      "defaultValue": ""
    },
    "genericOidcAudience": {
      "type": "string",
      "defaultValue": ""
    },
    "genericOidcClaimMapJson": {
      "type": "string",
      "defaultValue": "{}"
    },
    "genericOidcAssuranceJson": {
      "type": "string",
      "defaultValue": "{}"
    }
  },
  "resources": [
    {
      "type": "Microsoft.Web/sites/config",
      "apiVersion": "2024-04-01",
      "name": "[format('{0}/{1}', parameters('functionName'), 'authsettingsV2')]",
      "properties": {
        "platform": {
          "enabled": "[equals(parameters('authMode'), 'entra')]"
        },
        "globalValidation": {
          "requireAuthentication": "[equals(parameters('authMode'), 'entra')]",
          "unauthenticatedClientAction": "Return401",
          "excludedPaths": "[parameters('excludedAuthPaths')]"
        },
        "httpSettings": {
          "requireHttps": true,
          "forwardProxy": {
            "convention": "NoProxy"
          }
        },
        "identityProviders": {
          "azureActiveDirectory": {
            "enabled": "[equals(parameters('authMode'), 'entra')]",
            "registration": {
              "openIdIssuer": "[parameters('brokerIssuer')]",
              "clientId": "[parameters('brokerClientId')]",
              "allowedAudiences": [
                "[parameters('brokerClientId')]",
                "[parameters('brokerAppIdUri')]"
              ]
            },
            "validation": {
              "allowedAudiences": [
                "[parameters('brokerClientId')]",
                "[parameters('brokerAppIdUri')]"
              ],
              "jwtClaimChecks": {}
            }
          }
        }
      }
    }
  ],
  "outputs": {
    "authConfigured": {
      "type": "bool",
      "value": true
    },
    "allowedAudiences": {
      "type": "array",
      "value": [
        "[parameters('brokerClientId')]",
        "[parameters('brokerAppIdUri')]"
      ]
    },
    "issuer": {
      "type": "string",
      "value": "[parameters('brokerIssuer')]"
    }
  }
}